# Copy to .env and set a strong random secret.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Optional: override the database and add your own variables as needed.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/telecommunicator

# --- Federation ---
# How this homeserver is reached from outside: "host:port" or a full URL.
# Everything else (server identity in user@server handles, the base URL other
# servers use) is derived from it. Examples:
#   SERVER_ADDRESS=127.0.0.1:8000
#   SERVER_ADDRESS=zalupa.com:443
#   SERVER_ADDRESS=https://chat.example.net:8443
# SERVER_ADDRESS=127.0.0.1:8000